{
  "_schema_version": "1.0",
  "_description": "PathX tool-specific exceptions for path conversion. Only tools that need special handling are listed here. Default behavior: convert ALL Unix full paths for input, detect and convert Windows paths for output.",

  "input_exceptions": {
    "_description": "Tools that need special input argument handling to avoid converting specific arguments that look like paths but aren't",

    "git": {
      "never_convert_after_flags": ["--grep", "--author", "--committer", "--since", "--until", "--pretty", "--format", "--message", "-m"],
      "never_convert_at_positions": [],
      "never_convert_patterns": ["^[a-f0-9]{4,40}$", "^HEAD~?[0-9]*$", "^origin/", "^refs/"]
    },

    "rg": {
      "never_convert_after_flags": ["--regexp", "--file", "--glob", "--iglob", "--type-add", "--replace", "-e"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": ["\\.(txt|log|md|json|yml|yaml)$", "\\*\\.(txt|log|md|json|yml|yaml)$"]
    },

    "fd": {
      "never_convert_after_flags": ["--exclude", "--glob", "--regex", "--extension", "-e"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": ["\\*\\.", "\\.(txt|log|md|json|yml|yaml)$"]
    },

    "ag": {
      "never_convert_after_flags": ["--file-search-regex", "--ignore"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": []
    },

    "grep": {
      "never_convert_after_flags": ["--exclude", "--include", "--exclude-dir", "--include-dir"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": []
    },

    "find": {
      "never_convert_after_flags": ["-name", "-iname", "-path", "-ipath", "-regex", "-iregex", "-type", "-perm"],
      "never_convert_at_positions": [],
      "never_convert_patterns": ["\\*", "\\?", "\\[", "\\{"]
    },

    "7za": {
      "never_convert_after_flags": [],
      "never_convert_at_positions": [0, 1],
      "never_convert_patterns": ["^[adefltux]$", "^-[a-z]+"]
    },

    "node": {
      "never_convert_after_flags": ["--require", "--loader", "--import", "--experimental-loader"],
      "never_convert_at_positions": [],
      "never_convert_patterns": ["^[a-zA-Z][a-zA-Z0-9-_]*$"]
    },

    "python": {
      "never_convert_after_flags": ["-m", "--module", "-c"],
      "never_convert_at_positions": [],
      "never_convert_patterns": ["^[a-zA-Z][a-zA-Z0-9-_\\.]*$"]
    },

    "npm": {
      "never_convert_after_flags": ["install", "i", "uninstall", "run", "exec", "create"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": ["^@?[a-zA-Z][a-zA-Z0-9-_]*(/[a-zA-Z][a-zA-Z0-9-_]*)?$"]
    },

    "pip": {
      "never_convert_after_flags": ["install", "uninstall", "show", "list"],
      "never_convert_at_positions": [],
      "never_convert_patterns": ["^[a-zA-Z][a-zA-Z0-9-_\\.]*[=<>!]*"]
    },

    "conda": {
      "never_convert_after_flags": ["--name", "--prefix", "--channel", "--file", "install", "remove", "create"],
      "never_convert_at_positions": [],
      "never_convert_patterns": ["^[a-zA-Z][a-zA-Z0-9-_\\.]*[=<>!]*"]
    },

    "docker": {
      "never_convert_after_flags": ["--name", "--image", "--volume", "-v", "--env", "-e"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": ["^[a-zA-Z][a-zA-Z0-9-_]*(/[a-zA-Z][a-zA-Z0-9-_]*)*:.*"]
    },

    "kubectl": {
      "never_convert_after_flags": ["--namespace", "-n", "--context", "--kubeconfig"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": ["^[a-zA-Z][a-zA-Z0-9-]*$"]
    },

    "terraform": {
      "never_convert_after_flags": ["--var", "--var-file", "--state", "--backend-config"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": ["^[a-zA-Z][a-zA-Z0-9-_]*$"]
    },

    "helm": {
      "never_convert_after_flags": ["--namespace", "-n", "--kubeconfig", "--values", "-f"],
      "never_convert_at_positions": [0, 1],
      "never_convert_patterns": ["^[a-zA-Z][a-zA-Z0-9-]*(/[a-zA-Z][a-zA-Z0-9-]*)*$"]
    },

    "aws": {
      "never_convert_after_flags": ["--profile", "--region", "--output", "--cli-input-json", "--cli-input-yaml"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": ["^[a-zA-Z][a-zA-Z0-9-]*$"]
    },

    "gitleaks": {
      "never_convert_after_flags": ["--config", "--baseline-path", "--report-format", "--report-path"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": ["^[a-zA-Z][a-zA-Z0-9-]*$"]
    },

    "ripgrep": {
      "never_convert_after_flags": ["--regexp", "--file", "--glob", "--iglob", "--type-add", "--replace", "-e"],
      "never_convert_at_positions": [0],
      "never_convert_patterns": ["\\.(txt|log|md|json|yml|yaml)$", "\\*\\.(txt|log|md|json|yml|yaml)$"]
    }
  },

  "output_exceptions": {
    "_description": "Tools that need special output handling beyond the default Windows→Unix path conversion",

    "interactive_tools": {
      "_description": "Tools that should NEVER have output conversion (preserve TTY completely)",
      "tools": ["python", "node", "npm", "pip", "conda", "docker", "kubectl", "git", "vim", "nano", "less", "more", "top", "htop", "btop", "bash", "powershell", "cmd", "terraform", "helm", "aws", "gitui"],
      "force_direct_io": true
    },

    "file_listers": {
      "_description": "Tools that output pure file paths and need full conversion",
      "tools": ["fd", "find", "ls", "eza", "tree", "dir"],
      "convert_all_paths": true,
      "output_patterns": ["^[A-Za-z]:\\\\.*", "^/[A-Za-z]/.*", "^/mnt/[a-z]/.*", "^/cygdrive/[a-z]/.*"]
    },

    "search_tools": {
      "_description": "Tools that output filepath:line:content format",
      "tools": ["rg", "ripgrep", "ag", "grep", "ack", "gitleaks"],
      "convert_paths_only": true,
      "output_patterns": ["^([A-Za-z]:\\\\[^:]+):", "^(/[A-Za-z]/[^:]+):", "^(/mnt/[a-z]/[^:]+):", "^(/cygdrive/[a-z]/[^:]+):"]
    },

    "archive_tools": {
      "_description": "Tools that output archive contents with paths",
      "tools": ["7za", "7z", "tar", "zip", "unzip"],
      "convert_paths_only": true,
      "output_patterns": ["Extracting\\s+([A-Za-z]:\\\\.*)", "Creating\\s+([A-Za-z]:\\\\.*)", "\\s+([A-Za-z]:\\\\[^\\s]+)\\s*$"]
    },

    "development_tools": {
      "_description": "Development tools that may output file paths in errors/logs",
      "tools": ["go", "rust", "cargo", "gcc", "clang", "javac", "tsc"],
      "convert_paths_only": true,
      "output_patterns": ["^([A-Za-z]:\\\\[^:]+):[0-9]+:", "error:\\s*([A-Za-z]:\\\\[^:]+):", "warning:\\s*([A-Za-z]:\\\\[^:]+):"]
    }
  }
}