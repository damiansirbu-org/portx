# Set default behavior for line endings
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf

# Batch files should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Git LFS configuration for PORTX packages
# Track all executable files in packages directory
packages/**/*.exe filter=lfs diff=lfs merge=lfs -text
packages/**/*.dll filter=lfs diff=lfs merge=lfs -text
packages/**/*.zip filter=lfs diff=lfs merge=lfs -text
# Track large archives and installers
*.msi filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tar.xz filter=lfs diff=lfs merge=lfs -text
# Track specific large file types
*.chm filter=lfs diff=lfs merge=lfs -text
*.pem filter=lfs diff=lfs merge=lfs -text
# Release artifacts
release/*.zip filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text
