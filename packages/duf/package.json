{
  // ==========================================
  // PORTX Package Configuration (package.json)
  // ==========================================
  
  // CORE PACKAGE METADATA
  "name": "duf",
  "version": "0.8.1",
  "description": "Better df alternative with colorful output - user-friendly disk usage/free utility with smart color coding and customizable thresholds",
  "author": "PORTX Team",
  "license": "MIT",
  
  // IMPORT BEHAVIOR CONTROL
  "import": "auto",
  
  // EXECUTABLE DISCOVERY  
  "paths": [
    "./"
  ],
  
  // TOOL DEFINITIONS
  "tools": [
    {
      "executable": "duf.exe",
      "defaultArgs": "",
      "description": "Modern disk usage analyzer with colorful output and smart color coding - highlights availability and usage columns based on remaining space thresholds",
      "usage": "duf # Show all mounted filesystems\\nduf /home /var # Show specific paths\\nduf --all # Include pseudo, duplicate, inaccessible filesystems\\nduf --json # JSON output format\\nduf --sort size # Sort by filesystem size",
      "dependencies": "windows",
      "aliases": [],
      "category": "system",
      "tags": ["disk", "usage", "df", "alternative", "colorful", "filesystem", "storage", "analyzer"]
    }
  ],
  
  // PACKAGE METADATA
  "homepage": "https://github.com/muesli/duf",
  "repository": "https://github.com/muesli/duf",
  "keywords": ["disk", "usage", "df", "filesystem", "storage", "colorful"],
  "categories": ["system", "disk", "utilities"],
  
  // TECHNICAL CONFIGURATION
  "architecture": "x64",
  "platform": "win32",
  "runtime": "native"
}