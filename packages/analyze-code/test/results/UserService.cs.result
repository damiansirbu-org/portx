 356 │         /// <summary>
 357 │         /// Apply configuration-based filtering with complex logic
 358 │         /// </summary>
 359 │         private List<User> ApplyConfigurationFilters(List<User> users, Dictionary<string, object> config)
 360 │         {
 361 │             if (!config.Any())
 362 │             {
 363 │                 return users;
 364 │             }
 365 │ 
 366 │             try
 367 │             {
 368 │                 var filtered = users;
 369 │ 
 370 │                 // Complex filtering based on configuration
 371 │                 if (config.ContainsKey("features") && config["features"] is JsonElement featuresElement)
 372 │                 {
 373 │                     var features = featuresElement.EnumerateArray()
 374 │                         .Select(e => e.GetString())
 375 │                         .ToList();
 376 │ 
 377 │                     if (features.Contains("admin_filter"))
 378 │                     {
 379 │                         filtered = filtered.Where(u => u.IsActive).ToList();
 380 │                     }
 381 │ 
 382 │                     if (features.Contains("age_filter"))
 383 │                     {
 384 │                         filtered = filtered.Where(u => u.Age >= 18).ToList();
 385 │                     }
 386 │                 }
 387 │ 
 388 │                 return filtered;
 389 │             }
 390 │             catch (Exception ex)
 391 │             {
 392 │                 _logger.LogError(ex, "Error applying configuration filters");
 393 │                 return users;
 394 │             }
 395 │         }
