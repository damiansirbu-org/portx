  37 │         /// <summary>
  38 │         /// Complex user processing method with multiple nested conditions
  39 │         /// Cross-reference: TestService.java processUsers method
  40 │         /// </summary>
  41 │         public async Task<List<User>> ProcessUsersAsync(Dictionary<string, object> criteria)
  42 │         {
  43 │             if (criteria == null || !criteria.Any())
  44 │             {
  45 │                 throw new ArgumentException("Criteria cannot be null or empty", nameof(criteria));
  46 │             }
  47 │ 
  48 │             await _semaphore.WaitAsync();
  49 │ 
  50 │             try
  51 │             {
  52 │                 var results = new List<User>();
  53 │                 var processingTasks = new List<Task<List<User>>>();
  54 │ 
  55 │                 // Complex nested processing with multiple conditions
  56 │                 foreach (var kvp in criteria)
  57 │                 {
  58 │                     var key = kvp.Key;
  59 │                     var value = kvp.Value;
  60 │ 
  61 │                     _logger.LogInformation("Processing criteria: {Key} = {Value}", key, value);
  62 │ 
  63 │                     // Multi-branch logic for different value types
  64 │                     switch (value)
  65 │                     {
  66 │                         case string strValue when strValue.Length > 10:
  67 │                             processingTasks.Add(ProcessStringCriteriaAsync(key, strValue));
  68 │                             break;
  69 │ 
  70 │                         case int intValue when intValue > 0:
  71 │                             processingTasks.Add(ProcessIntegerCriteriaAsync(key, intValue));
  72 │                             break;
  73 │ 
  74 │                         case List<object> listValue:
  75 │                             processingTasks.Add(ProcessListCriteriaAsync(key, listValue));
  76 │                             break;
  77 │ 
  78 │                         case Dictionary<string, object> dictValue:
  79 │                             processingTasks.Add(ProcessDictionaryCriteriaAsync(key, dictValue));
  80 │                             break;
  81 │ 
  82 │                         default:
  83 │                             _logger.LogWarning("Unsupported criteria type for key: {Key}", key);
  84 │                             break;
  85 │                     }
  86 │                 }
  87 │ 
  88 │                 // Await all processing tasks
  89 │                 var taskResults = await Task.WhenAll(processingTasks);
  90 │ 
  91 │                 // Merge results with complex logic
  92 │                 foreach (var taskResult in taskResults)
  93 │                 {
  94 │                     if (taskResult != null && taskResult.Any())
  95 │                     {
  96 │                         results.AddRange(taskResult);
  97 │                     }
  98 │                 }
  99 │ 
 100 │                 // Execute cross-platform script integration
 101 │                 var scriptResult = await ExecuteBashScriptAsync("process_users.sh", results.Count.ToString());
 102 │                 
 103 │                 // Load configuration from YAML (cross-reference)
 104 │                 var configData = await LoadYamlConfigurationAsync("config.yaml");
 105 │ 
 106 │                 // Apply configuration-based filtering
 107 │                 results = ApplyConfigurationFilters(results, configData);
 108 │ 
 109 │                 // Cache results
 110 │                 var cacheKey = GenerateCacheKey(criteria);
 111 │                 _cache[cacheKey] = results;
 112 │ 
 113 │                 return results;
 114 │             }
 115 │             catch (Exception ex)
 116 │             {
 117 │                 _logger.LogError(ex, "Error processing users with criteria: {Criteria}", 
 118 │                     JsonSerializer.Serialize(criteria));
 119 │                 throw;
 120 │             }
 121 │             finally
 122 │             {
 123 │                 _semaphore.Release();
 124 │             }
 125 │         }
