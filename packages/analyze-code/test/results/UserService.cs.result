 397 │         /// <summary>
 398 │         /// Generate cache key from criteria
 399 │         /// </summary>
 400 │         private string GenerateCacheKey(Dictionary<string, object> criteria)
 401 │         {
 402 │             try
 403 │             {
 404 │                 var serialized = JsonSerializer.Serialize(criteria);
 405 │                 return Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(serialized));
 406 │             }
 407 │             catch
 408 │             {
 409 │                 return Guid.NewGuid().ToString();
 410 │             }
 411 │         }
 412 │     }
