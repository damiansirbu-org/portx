 259 │         private async Task<List<User>> ProcessDictionaryCriteriaAsync(string key, Dictionary<string, object> dictionary)
 260 │         {
 261 │             try
 262 │             {
 263 │                 // Recursive processing of nested criteria
 264 │                 return await ProcessUsersAsync(dictionary);
 265 │             }
 266 │             catch (Exception ex)
 267 │             {
