 273 │         /// <summary>
 274 │         /// Execute bash script for cross-platform integration
 275 │         /// Cross-reference: json_helper.py execute_bash_script
 276 │         /// </summary>
 277 │         private async Task<string> ExecuteBashScriptAsync(string scriptName, params string[] args)
 278 │         {
 279 │             try
 280 │             {
 281 │                 var scriptPath = Path.Combine(Directory.GetCurrentDirectory(), "scripts", scriptName);
 282 │                 var arguments = string.Join(" ", args);
 283 │                 var command = $"bash \"{scriptPath}\" {arguments}";
 284 │ 
 285 │                 var processInfo = new ProcessStartInfo("bash", $"-c \"{command}\"")
 286 │                 {
 287 │                     RedirectStandardOutput = true,
 288 │                     RedirectStandardError = true,
 289 │                     UseShellExecute = false,
 290 │                     CreateNoWindow = true
 291 │                 };
 292 │ 
 293 │                 using var process = Process.Start(processInfo);
 294 │                 if (process != null)
 295 │                 {
 296 │                     var output = await process.StandardOutput.ReadToEndAsync();
 297 │                     var error = await process.StandardError.ReadToEndAsync();
 298 │ 
 299 │                     await process.WaitForExitAsync();
 300 │ 
 301 │                     if (process.ExitCode != 0)
 302 │                     {
 303 │                         throw new InvalidOperationException($"Script failed: {error}");
 304 │                     }
 305 │ 
 306 │                     return output.Trim();
 307 │                 }
 308 │ 
 309 │                 return string.Empty;
 310 │             }
 311 │             catch (Exception ex)
 312 │             {
 313 │                 _logger.LogError(ex, "Error executing bash script: {ScriptName}", scriptName);
 314 │                 return string.Empty;
 315 │             }
 316 │         }
