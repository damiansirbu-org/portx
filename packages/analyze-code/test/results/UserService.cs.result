 127 │         /// <summary>
 128 │         /// Process string-based search criteria with complex logic
 129 │         /// </summary>
 130 │         private async Task<List<User>> ProcessStringCriteriaAsync(string key, string value)
 131 │         {
 132 │             var users = new List<User>();
 133 │ 
 134 │             try
 135 │             {
 136 │                 // Complex string processing with multiple conditions
 137 │                 for (int i = 0; i < value.Length; i++)
 138 │                 {
 139 │                     if (char.IsDigit(value[i]))
 140 │                     {
 141 │                         // Extract numeric portion and use for database query
 142 │                         var numericPart = new string(value.Skip(i).TakeWhile(char.IsDigit).ToArray());
 143 │                         
 144 │                         if (int.TryParse(numericPart, out int numericValue))
 145 │                         {
 146 │                             var queryResult = await _databaseConnection.QueryAsync<User>(
 147 │                                 $"SELECT * FROM users WHERE {key} LIKE @pattern",
 148 │                                 new { pattern = $"%{numericValue}%" }
 149 │                             );
 150 │                             
 151 │                             users.AddRange(queryResult);
 152 │                             break;
 153 │                         }
 154 │                     }
 155 │                 }
 156 │ 
 157 │                 // Additional processing based on string patterns
 158 │                 if (value.Contains("@"))
 159 │                 {
 160 │                     var emailUsers = await _databaseConnection.QueryAsync<User>(
 161 │                         "SELECT * FROM users WHERE email = @email",
 162 │                         new { email = value }
 163 │                     );
 164 │                     users.AddRange(emailUsers);
 165 │                 }
 166 │ 
 167 │             }
 168 │             catch (Exception ex)
 169 │             {
 170 │                 _logger.LogError(ex, "Error processing string criteria: {Key} = {Value}", key, value);
 171 │             }
 172 │ 
 173 │             return users;
 174 │         }
 175 │ 
 176 │         /// <summary>
 177 │         /// Process integer-based criteria
 178 │         /// </summary>
 179 │         private async Task<List<User>> ProcessIntegerCriteriaAsync(string key, int value)
 180 │         {
 181 │             try
 182 │             {
 183 │                 // Complex integer processing with range logic
 184 │                 var rangeQueries = new List<Task<IEnumerable<User>>>();
 185 │ 
 186 │                 // Multiple range queries for complexity testing
 187 │                 for (int offset = -2; offset <= 2; offset++)
 188 │                 {
 189 │                     var searchValue = value + offset;
 190 │                     if (searchValue > 0)
 191 │                     {
 192 │                         var query = _databaseConnection.QueryAsync<User>(
 193 │                             $"SELECT * FROM users WHERE {key} = @value",
 194 │                             new { value = searchValue }
 195 │                         );
 196 │                         rangeQueries.Add(query);
 197 │                     }
 198 │                 }
 199 │ 
 200 │                 var results = await Task.WhenAll(rangeQueries);
 201 │                 return results.SelectMany(r => r).Distinct().ToList();
 202 │             }
 203 │             catch (Exception ex)
 204 │             {
 205 │                 _logger.LogError(ex, "Error processing integer criteria: {Key} = {Value}", key, value);
 206 │                 return new List<User>();
 207 │             }
 208 │         }
 209 │ 
 210 │         /// <summary>
 211 │         /// Process list-based criteria with complex filtering
 212 │         /// </summary>
 213 │         private async Task<List<User>> ProcessListCriteriaAsync(string key, List<object> values)
 214 │         {
 215 │             var users = new List<User>();
 216 │ 
 217 │             try
 218 │             {
 219 │                 // Complex list processing with type-specific handling
 220 │                 foreach (var item in values)
 221 │                 {
 222 │                     switch (item)
 223 │                     {
 224 │                         case string strItem:
 225 │                             var stringResults = await ProcessStringCriteriaAsync(key, strItem);
 226 │                             users.AddRange(stringResults);
 227 │                             break;
 228 │ 
 229 │                         case int intItem:
 230 │                             var intResults = await ProcessIntegerCriteriaAsync(key, intItem);
 231 │                             users.AddRange(intResults);
 232 │                             break;
 233 │ 
 234 │                         case Dictionary<string, object> dictItem:
 235 │                             var dictResults = await ProcessDictionaryCriteriaAsync(key, dictItem);
 236 │                             users.AddRange(dictResults);
 237 │                             break;
 238 │                     }
 239 │                 }
 240 │ 
 241 │                 // Remove duplicates with complex comparison
 242 │                 users = users
 243 │                     .GroupBy(u => u.Id)
 244 │                     .Select(g => g.First())
 245 │                     .ToList();
 246 │ 
 247 │             }
 248 │             catch (Exception ex)
 249 │             {
 250 │                 _logger.LogError(ex, "Error processing list criteria: {Key}", key);
 251 │             }
 252 │ 
 253 │             return users;
 254 │         }
