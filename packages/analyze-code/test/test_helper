#!/usr/bin/env bash

# Test helper functions for analyzer validation

# Function to validate JSON syntax using gojq
validate_json_syntax() {
    local json_file="$1"
    
    # Check file exists and has content
    [ -s "$json_file" ] || return 1
    
    # Use gojq to validate JSON
    if command -v "/c/App/Git/bin/gojq" >/dev/null 2>&1; then
        "/c/App/Git/bin/gojq" empty < "$json_file" >/dev/null 2>&1
        return $?
    else
        # Simple fallback - file exists and has reasonable content
        local content_length=$(wc -c < "$json_file" 2>/dev/null || echo "0")
        [ "$content_length" -gt 10 ] && return 0 || return 1
    fi
}

# Export functions for use in tests
export -f validate_json_syntax
