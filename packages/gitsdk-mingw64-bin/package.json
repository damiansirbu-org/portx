  // CORE PACKAGE METADATA
  "name": "gitsdk-mingw64-bin",
  "version": "2.51.0",
  "description": "Complete mingw64/bin directory from Git for Windows SDK - 32 Windows-native executables including curl, openssl, bzip2, antiword, pdftotext, and compression utilities. These are x64 native Windows binaries that bridge the gap between MinGit (90 tools) and Full Git (416 tools), providing essential development and system utilities missing from the minimal MinGit installation.",
  "author": "PORTX Team",
  "license": "Various",
  
  // IMPORT BEHAVIOR CONTROL
  "import": "path",                       // Force PATH mode - add entire directory to PATH
  "importType": "path",                   // Prevents wrapper script generation
  
  // EXECUTABLE DISCOVERY  
  "paths": [
    "./"                                  // All executables in root directory
  ],
  
  // TECHNICAL CONFIGURATION
  "architecture": "x64",
  "platform": "win32",
  "runtime": "native",
  "source": "Git for Windows Full Installation",
  "categories": ["development", "system", "utilities"],
  
