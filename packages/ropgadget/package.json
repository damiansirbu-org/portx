{
  "name": "ropgadget",
  "version": "7.4.0",
  "description": "Return Oriented Programming gadget finder and automatic ROP chain generator",
  "category": "security",
  "homepage": "https://github.com/JonathanSalwan/ROPgadget",
  "license": "BSD-3-Clause",
  "keywords": ["security", "exploit", "rop", "gadget", "reverse-engineering", "binary-analysis"],
  "author": "Jonathan Salwan",
  
  "tools": [
    {
      "executable": "ROPgadget.py",
      "description": "Python script to search ROP gadgets in binary files and generate exploit chains",
      "usage": "python ROPgadget.py --binary ./binary",
      "examples": [
        "python ROPgadget.py --binary ./binary --ropchain",
        "python ROPgadget.py --binary ./binary --string 'system'",
        "python ROPgadget.py --binary ./binary --only 'pop|ret'",
        "python ROPgadget.py --binary ./binary --badbytes '00|0a|0d'",
        "python ROPgadget.py --binary ./binary --depth 5"
      ],
      "flags": ["--help", "--version"],
      "common_args": [
        "--binary",
        "--ropchain",
        "--string",
        "--only",
        "--badbytes",
        "--depth",
        "--offset",
        "--memstr",
        "--console"
      ],
      "dependencies": "python",
      "aliases": [],
      "category": "security",
      "source": "."
    }
  ],
  "tags": ["security", "exploit", "rop", "python", "analysis"],

  "paths": [
    "."
  ]
}