{
  "name": "ffmpeg",
  "version": "7.1.0",
  "description": "Complete, cross-platform solution to record, convert and stream audio and video",
  "category": "media",
  "homepage": "https://ffmpeg.org/",
  "license": "LGPL-2.1+",
  "keywords": ["video", "audio", "converter", "encoder", "decoder", "streaming", "multimedia"],
  "author": "FFmpeg team",
  
  "tools": [
    {
      "executable": "ffmpeg.exe",
      "description": "Universal multimedia converter and processor",
      "usage": "ffmpeg -i input.mp4 output.avi",
      "examples": [
        "ffmpeg -i video.mp4 -c:v libx264 -crf 23 compressed.mp4",
        "ffmpeg -i input.mp4 -vn -ar 44100 -ac 2 -b:a 192k output.mp3",
        "ffmpeg -i input.mp4 -ss 00:01:30 -t 00:00:30 -c copy clip.mp4"
      ],
      "flags": ["--help", "--version"],
      "common_args": ["-i", "-c:v", "-c:a", "-b:v", "-b:a", "-r", "-s", "-ss", "-t", "-f"],
      "dependencies": "windows",
      "aliases": [],
      "category": "media",
      "source": "bin"
    },
    {
      "executable": "ffplay.exe",
      "description": "Simple media player based on SDL and FFmpeg libraries",
      "usage": "ffplay input.mp4",
      "examples": [
        "ffplay movie.mp4",
        "ffplay -loop 0 animation.gif",
        "ffplay -f lavfi testsrc2=size=320x240:rate=30"
      ],
      "flags": ["--help", "--version"],
      "common_args": ["-loop", "-volume", "-fs", "-an", "-vn"],
      "dependencies": "windows",
      "aliases": [],
      "category": "media",
      "source": "bin"
    },
    {
      "executable": "ffprobe.exe",
      "description": "Multimedia stream analyzer and metadata extractor",
      "usage": "ffprobe input.mp4",
      "examples": [
        "ffprobe -v quiet -print_format json -show_format video.mp4",
        "ffprobe -v error -select_streams v:0 -show_entries stream=width,height -of csv=s=x:p=0 input.mp4",
        "ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 video.mp4"
      ],
      "flags": ["--help", "--version"],
      "common_args": ["-v", "-show_format", "-show_streams", "-print_format", "-select_streams"],
      "dependencies": "windows",
      "aliases": [],
      "category": "media",
      "source": "bin"
    }
  ],
  "tags": ["media", "video", "audio", "converter", "native"],

  "paths": [
    "bin/"
  ]
}