{
  // ==========================================
  // PORTX Package Configuration (package.json)
  // ==========================================
  
  // CORE PACKAGE METADATA
  "name": "http-prompt",
  "version": "2.1.0",
  "description": "Interactive HTTPie shell with auto-completion, syntax highlighting, and session management - perfect for API development and testing",
  "author": "PORTX Team",
  "license": "MIT",
  
  // IMPORT BEHAVIOR CONTROL
  "import": "auto",
  
  // EXECUTABLE DISCOVERY  
  "paths": [
    "./"
  ],
  
  // TOOL DEFINITIONS
  "tools": [
    {
      "executable": "python-env/python.exe",
      "defaultArgs": "-m http_prompt",
      "description": "Interactive HTTPie shell with auto-completion, syntax highlighting, and session management - navigate APIs like directories with persistent sessions",
      "usage": "http-prompt # Start interactive shell\\nhttp-prompt https://api.github.com # Connect to specific API\\nhttp-prompt --print-others # Show all available options",
      "dependencies": "windows",
      "aliases": ["http-prompt"],
      "category": "network",
      "tags": ["http", "interactive", "shell", "api", "testing", "autocomplete", "sessions", "httpie"]
    }
  ],
  
  // PACKAGE METADATA
  "homepage": "http://http-prompt.com/",
  "repository": "https://github.com/httpie/http-prompt",
  "keywords": ["http", "prompt", "interactive", "api", "testing", "shell", "httpie"],
  "categories": ["network", "api", "testing", "interactive"],
  
  // TECHNICAL CONFIGURATION
  "architecture": "x64",
  "platform": "win32",
  "runtime": "python"
}