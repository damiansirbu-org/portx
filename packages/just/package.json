{
  // ==========================================
  // PORTX Package Configuration (package.json)
  // ==========================================
  
  // CORE PACKAGE METADATA
  "name": "just",
  "version": "1.36.0",
  "description": "Modern command runner and task automation tool - simpler make alternative with backwards compatibility promise and cross-platform support",
  "author": "PORTX Team",
  "license": "CC0-1.0",
  
  // IMPORT BEHAVIOR CONTROL
  "import": "auto",
  
  // EXECUTABLE DISCOVERY  
  "paths": [
    "./"
  ],
  
  // TOOL DEFINITIONS
  "tools": [
    {
      "executable": "just.exe",
      "defaultArgs": "",
      "description": "Command runner for project-specific tasks with make-inspired syntax - no .PHONY recipes needed, works from any subdirectory, never breaking backwards compatibility",
      "usage": "just # Run default recipe\\njust --list # Show available recipes\\njust build # Run build recipe\\njust test --verbose # Run test recipe with arguments\\njust --working-directory /path/to/project build # Run from specific directory",
      "dependencies": "windows",
      "aliases": [],
      "category": "automation",
      "tags": ["task", "runner", "make", "alternative", "automation", "justfile", "recipes", "commands"]
    }
  ],
  
  // PACKAGE METADATA
  "homepage": "https://just.systems/",
  "repository": "https://github.com/casey/just",
  "keywords": ["just", "task", "runner", "make", "automation", "command"],
  "categories": ["automation", "development", "build"],
  
  // TECHNICAL CONFIGURATION
  "architecture": "x64", 
  "platform": "win32",
  "runtime": "native"
}