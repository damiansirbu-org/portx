{
  // ==========================================
  // PORTX Package Configuration (package.json)
  // ==========================================
  
  // CORE PACKAGE METADATA
  "name": "choose",
  "version": "1.3.4",
  "description": "Human-friendly alternative to cut and awk with intuitive field selection syntax - supports negative indexing and Python-like slice notation",
  "author": "PORTX Team",
  "license": "GPL-3.0",
  
  // IMPORT BEHAVIOR CONTROL
  "import": "auto",
  
  // EXECUTABLE DISCOVERY  
  "paths": [
    "./"
  ],
  
  // TOOL DEFINITIONS
  "tools": [
    {
      "executable": "choose.exe",
      "defaultArgs": "",
      "description": "Human-friendly field selection tool with Python-like syntax - easier than cut/awk for rapid shell use with negative indexing and regex separators",
      "usage": "echo 'one two three' | choose 0 # Select first field (zero-indexed)\\necho 'one two three four' | choose 1:3 # Select fields 1-2 (slice notation)\\necho 'one two three' | choose -1 # Select last field (negative indexing)\\necho 'a:b:c:d' | choose -f ':' 1 3 # Custom separator and multiple fields",
      "dependencies": "windows",
      "aliases": [],
      "category": "text-processing",
      "tags": ["text", "fields", "cut", "awk", "alternative", "slice", "indexing", "rust"]
    }
  ],
  
  // PACKAGE METADATA
  "homepage": "https://github.com/theryangeary/choose",
  "repository": "https://github.com/theryangeary/choose",
  "keywords": ["choose", "cut", "awk", "fields", "text", "processing", "slice"],
  "categories": ["text-processing", "utilities"],
  
  // TECHNICAL CONFIGURATION
  "architecture": "x64",
  "platform": "win32",
  "runtime": "native"
}