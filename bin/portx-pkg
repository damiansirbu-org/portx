#!/bin/bash
# PORTX Package Manager - Simple CLI Interface
# Usage: portx-pkg <command> [args]

set -euo pipefail

# Simple, direct approach - no over-engineering
PORTX_ROOT="${PORTX_ROOT:-C:/App/PORTX}"
PKG_DIR="$PORTX_ROOT/packages"
INSTALLED_DB="$PORTX_ROOT/.portx/installed.json"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m' 
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

show_usage() {
    echo "PORTX Package Manager"
    echo
    echo "Usage: portx-pkg <command> [args]"
    echo
    echo "Commands:"
    echo "  install <package>     Install a package"
    echo "  remove <package>      Remove a package"
    echo "  list                  List installed packages"
    echo "  search <query>        Search available packages"
    echo "  info <package>        Show package information"
    echo "  update [package]      Update package(s)"
    echo "  status                Show system status"
    echo
    echo "Examples:"
    echo "  portx-pkg install kubectl"
    echo "  portx-pkg search kubernetes"
    echo "  portx-pkg list"
    echo "  portx-pkg info kubectl"
}

# Package installation with remote repository support
install_package() {
    local package_name="$1"
    
    if [[ -z "$package_name" ]]; then
        echo -e "${RED}Error: Package name required${NC}"
        exit 1
    fi
    
    # Check if already installed
    if is_installed "$package_name"; then
        echo -e "${YELLOW}Package '$package_name' is already installed${NC}"
        return 0
    fi
    
    # Check if package exists locally first
    local package_dir="$PKG_DIR/$package_name"
    if [[ ! -d "$package_dir" ]]; then
        # Try to install from remote repository
        echo -e "${YELLOW}Package '$package_name' not found locally${NC}"
        echo -e "${BLUE}Checking remote repositories...${NC}"
        
        if command -v portx-repo >/dev/null 2>&1; then
            # Try remote installation
            if portx-repo install "$package_name"; then
                echo -e "${GREEN}✓ Package installed from remote repository${NC}"
                return 0
            fi
        fi
        
        echo -e "${RED}Error: Package '$package_name' not found locally or remotely${NC}"
        echo "Try:"
        echo "  portx-repo update          # Update remote package index"
        echo "  portx-repo search $package_name  # Search remote packages"
        echo "  portx-pkg available        # List local packages"
        exit 1
    fi
    
    echo -e "${BLUE}Installing $package_name...${NC}"
    
    # Simple installation - just ensure it's in PATH
    # The package already exists in $PKG_DIR/$package_name
    # PORTX tools are already discoverable via the existing tool system
    
    # Record installation
    record_installation "$package_name" "$package_dir"
    
    echo -e "${GREEN}✓ Package '$package_name' installed successfully${NC}"
    
    # Show executables
    if [[ -f "$package_dir/package-manual.md" ]]; then
        echo "📄 Documentation: $package_dir/package-manual.md"
    fi
    
    # List executables in package
    local executables
    executables=$(find "$package_dir" -name "*.exe" -type f | head -5)
    if [[ -n "$executables" ]]; then
        echo "🔧 Executables available:"
        echo "$executables" | while read -r exe; do
            local exe_name
            exe_name=$(basename "$exe" .exe)
            echo "   $exe_name"
        done
    fi
}

# Simple package removal
remove_package() {
    local package_name="$1"
    
    if [[ -z "$package_name" ]]; then
        echo -e "${RED}Error: Package name required${NC}"
        exit 1
    fi
    
    if ! is_installed "$package_name"; then
        echo -e "${RED}Error: Package '$package_name' is not installed${NC}"
        exit 1
    fi
    
    echo -e "${BLUE}Removing $package_name...${NC}"
    
    # For PORTX, removal means removing from installed tracking
    # The files stay in place for now (simple approach)
    remove_installation_record "$package_name"
    
    echo -e "${GREEN}✓ Package '$package_name' removed successfully${NC}"
}

# List installed packages
list_installed() {
    if [[ ! -f "$INSTALLED_DB" ]]; then
        echo "No packages installed"
        return 0
    fi
    
    echo -e "${GREEN}Installed packages:${NC}"
    echo
    
    # Simple JSON parsing with jq if available, otherwise basic parsing
    if command -v jq >/dev/null 2>&1; then
        jq -r '.packages[] | "\(.name) \(.version) - \(.installed_at)"' "$INSTALLED_DB" 2>/dev/null || {
            # Fallback to basic parsing
            grep '"name"' "$INSTALLED_DB" | sed 's/.*"name": *"\([^"]*\)".*/\1/' | sort
        }
    else
        # Basic parsing without jq
        grep '"name"' "$INSTALLED_DB" | sed 's/.*"name": *"\([^"]*\)".*/\1/' | sort
    fi
}

# Search packages (local and remote)
search_packages() {
    local query="$1"
    
    if [[ -z "$query" ]]; then
        echo -e "${RED}Error: Search query required${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}Searching for '$query'...${NC}"
    echo
    
    local found=0
    
    # Search local packages first
    echo -e "${CYAN}Local packages:${NC}"
    for package_dir in "$PKG_DIR"/*; do
        if [[ -d "$package_dir" ]]; then
            local package_name
            package_name=$(basename "$package_dir")
            
            # Simple case-insensitive search in name
            if [[ "$package_name" == *"${query,,}"* ]]; then
                local status=""
                if is_installed "$package_name"; then
                    status=" ${GREEN}[installed]${NC}"
                fi
                
                echo -e "  ${BLUE}$package_name${NC}$status"
                
                # Try to show description from package-manual.md
                if [[ -f "$package_dir/package-manual.md" ]]; then
                    local description
                    description=$(head -5 "$package_dir/package-manual.md" | grep -v "^#" | head -1 | sed 's/^[[:space:]]*//')
                    if [[ -n "$description" ]]; then
                        echo "    $description"
                    fi
                fi
                
                ((found++))
            fi
        fi
    done
    
    # Search remote repositories if available
    if command -v portx-repo >/dev/null 2>&1; then
        echo
        echo -e "${CYAN}Remote packages:${NC}"
        local remote_found=0
        
        # Check if we have a package index
        local index_file="$PORTX_ROOT/.portx/cache/package-index.json"
        if [[ -f "$index_file" ]]; then
            if command -v jq >/dev/null 2>&1; then
                jq -r --arg query "${query,,}" '.packages[] | select(.name | ascii_downcase | contains($query)) | 
                       "\(.name)|\(.size)|\(.repository)"' "$index_file" | \
                while IFS='|' read -r name size repo; do
                    if [[ -n "$name" ]]; then
                        # Check if already available locally
                        local local_status=""
                        if [[ -d "$PKG_DIR/$name" ]]; then
                            if is_installed "$name"; then
                                local_status=" ${GREEN}[installed locally]${NC}"
                            else
                                local_status=" ${YELLOW}[available locally]${NC}"
                            fi
                        else
                            local_status=" ${BLUE}[remote only]${NC}"
                        fi
                        
                        echo -e "  ${BLUE}$name${NC}$local_status"
                        echo "    Repository: $repo, Size: $(format_size_simple "$size")"
                        ((remote_found++))
                    fi
                done
            fi
        else
            echo "  Run 'portx-repo update' to search remote packages"
        fi
    fi
    
    echo
    if [[ $found -eq 0 ]]; then
        echo "No local packages found matching '$query'"
        echo
        echo "Try:"
        echo "  portx-repo update           # Update remote package index"
        echo "  portx-repo search $query    # Search only remote packages"
        echo "  portx-pkg available         # List all local packages"
    else
        echo "Found $found local packages"
        echo
        echo "To install: portx-pkg install <package-name>"
    fi
}

# Show package information
show_package_info() {
    local package_name="$1"
    
    if [[ -z "$package_name" ]]; then
        echo -e "${RED}Error: Package name required${NC}"
        exit 1
    fi
    
    local package_dir="$PKG_DIR/$package_name"
    if [[ ! -d "$package_dir" ]]; then
        echo -e "${RED}Error: Package '$package_name' not found${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}Package: $package_name${NC}"
    echo
    
    # Show installation status
    if is_installed "$package_name"; then
        echo -e "Status: ${GREEN}Installed${NC}"
    else
        echo -e "Status: ${YELLOW}Available${NC}"
    fi
    
    # Show package directory
    echo "Location: $package_dir"
    
    # Show executables
    local exe_count
    exe_count=$(find "$package_dir" -name "*.exe" -type f | wc -l)
    echo "Executables: $exe_count"
    
    # Show size
    local size
    size=$(du -sh "$package_dir" 2>/dev/null | cut -f1 || echo "Unknown")
    echo "Size: $size"
    
    # Show manual if available
    if [[ -f "$package_dir/package-manual.md" ]]; then
        echo
        echo -e "${BLUE}Description:${NC}"
        head -10 "$package_dir/package-manual.md" | grep -v "^#"
    fi
    
    echo
    echo "To install: portx-pkg install $package_name"
}

# List available packages
list_available_packages() {
    echo -e "${GREEN}Available packages:${NC}"
    for package_dir in "$PKG_DIR"/*; do
        if [[ -d "$package_dir" ]]; then
            local package_name
            package_name=$(basename "$package_dir")
            echo "  $package_name"
        fi
    done
}

# Show system status
show_status() {
    echo -e "${GREEN}PORTX Package Manager Status${NC}"
    echo
    echo "PORTX Root: $PORTX_ROOT"
    echo "Packages Directory: $PKG_DIR"
    echo "Database: $INSTALLED_DB"
    echo
    
    # Count packages
    local available_count=0
    local installed_count=0
    
    if [[ -d "$PKG_DIR" ]]; then
        available_count=$(find "$PKG_DIR" -maxdepth 1 -type d | wc -l)
        ((available_count--)) # Subtract the parent directory
    fi
    
    if [[ -f "$INSTALLED_DB" ]]; then
        installed_count=$(grep -c '"name"' "$INSTALLED_DB" 2>/dev/null || echo 0)
    fi
    
    echo "Available packages: $available_count"
    echo "Installed packages: $installed_count"
    echo
    
    # Check for issues
    if [[ ! -d "$PKG_DIR" ]]; then
        echo -e "${YELLOW}⚠ Warning: Packages directory not found${NC}"
    fi
    
    if [[ ! -w "$(dirname "$INSTALLED_DB")" ]]; then
        echo -e "${YELLOW}⚠ Warning: Cannot write to database directory${NC}"
    fi
}

# Helper functions
is_installed() {
    local package_name="$1"
    [[ -f "$INSTALLED_DB" ]] && grep -q "\"name\": *\"$package_name\"" "$INSTALLED_DB"
}

record_installation() {
    local package_name="$1"
    local package_dir="$2"
    
    # Ensure database directory exists
    mkdir -p "$(dirname "$INSTALLED_DB")"
    
    # Simple JSON structure
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    
    # Initialize or update JSON database
    if [[ ! -f "$INSTALLED_DB" ]]; then
        echo '{"packages": []}' > "$INSTALLED_DB"
    fi
    
    # Add package record (simple approach)
    local temp_file
    temp_file=$(mktemp)
    
    if command -v jq >/dev/null 2>&1; then
        # Use jq if available
        jq --arg name "$package_name" --arg path "$package_dir" --arg time "$timestamp" \
           '.packages += [{"name": $name, "path": $path, "installed_at": $time, "version": "latest"}]' \
           "$INSTALLED_DB" > "$temp_file" && mv "$temp_file" "$INSTALLED_DB"
    else
        # Fallback: manual JSON editing
        sed '$ s/]//' "$INSTALLED_DB" > "$temp_file"
        if grep -q '"packages": \[\]' "$temp_file"; then
            sed 's/"packages": \[\]/"packages": [/' "$temp_file" > "$INSTALLED_DB"
        else
            echo "," >> "$temp_file"
            mv "$temp_file" "$INSTALLED_DB"
        fi
        echo "    {\"name\": \"$package_name\", \"path\": \"$package_dir\", \"installed_at\": \"$timestamp\", \"version\": \"latest\"}" >> "$INSTALLED_DB"
        echo "  ]" >> "$INSTALLED_DB"
        echo "}" >> "$INSTALLED_DB"
    fi
    
    rm -f "$temp_file"
}

remove_installation_record() {
    local package_name="$1"
    
    if [[ ! -f "$INSTALLED_DB" ]]; then
        return 0
    fi
    
    local temp_file
    temp_file=$(mktemp)
    
    if command -v jq >/dev/null 2>&1; then
        # Use jq if available
        jq --arg name "$package_name" '.packages = (.packages | map(select(.name != $name)))' \
           "$INSTALLED_DB" > "$temp_file" && mv "$temp_file" "$INSTALLED_DB"
    else
        # Fallback: remove line containing the package
        grep -v "\"name\": *\"$package_name\"" "$INSTALLED_DB" > "$temp_file" && mv "$temp_file" "$INSTALLED_DB"
    fi
    
    rm -f "$temp_file"
}

# Simple size formatting utility
format_size_simple() {
    local size="$1"
    if [[ "$size" -gt 1048576 ]]; then
        echo "$((size / 1048576))MB"
    elif [[ "$size" -gt 1024 ]]; then
        echo "$((size / 1024))KB"
    else
        echo "${size}B"
    fi
}

# Main command dispatcher
main() {
    local command="${1:-}"
    
    case "$command" in
        "install"|"i")
            install_package "${2:-}"
            ;;
        "remove"|"uninstall"|"r")
            remove_package "${2:-}"
            ;;
        "list"|"ls")
            list_installed
            ;;
        "search"|"s")
            search_packages "${2:-}"
            ;;
        "info"|"show")
            show_package_info "${2:-}"
            ;;
        "available"|"list-available")
            list_available_packages
            ;;
        "status"|"stat")
            show_status
            ;;
        "help"|"-h"|"--help"|"")
            show_usage
            ;;
        *)
            echo -e "${RED}Unknown command: $command${NC}"
            echo
            show_usage
            exit 1
            ;;
    esac
}

# Run main function
main "$@"