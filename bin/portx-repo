#!/bin/bash
# PORTX Package Repository Manager
# Fetches packages from GitHub releases and manages repositories

set -euo pipefail

# Configuration
PORTX_ROOT="${PORTX_ROOT:-C:/App/PORTX}"
PKG_DIR="$PORTX_ROOT/packages"
REPO_CONFIG="$PORTX_ROOT/.portx/repositories.json"
CACHE_DIR="$PORTX_ROOT/.portx/cache"
DEFAULT_REPO="https://api.github.com/repos/damiansirbu/portx/releases"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m' 
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

show_usage() {
    echo "PORTX Repository Manager"
    echo
    echo "Usage: portx-repo <command> [args]"
    echo
    echo "Commands:"
    echo "  update                    Update package index from repositories"
    echo "  search <query>            Search remote packages"
    echo "  info <package>            Show remote package info"
    echo "  install <package>         Download and install package"
    echo "  list-remote               List all remote packages"
    echo "  add-repo <url>            Add package repository"
    echo "  list-repos                List configured repositories"
    echo "  cache-clear               Clear download cache"
    echo
    echo "Examples:"
    echo "  portx-repo update"
    echo "  portx-repo search kubectl"
    echo "  portx-repo install kubectl"
    echo "  portx-repo add-repo https://api.github.com/repos/user/repo/releases"
}

# Initialize repository configuration
init_repos() {
    mkdir -p "$(dirname "$REPO_CONFIG")"
    mkdir -p "$CACHE_DIR"
    
    if [[ ! -f "$REPO_CONFIG" ]]; then
        cat > "$REPO_CONFIG" << EOF
{
  "repositories": [
    {
      "name": "portx-main",
      "url": "$DEFAULT_REPO",
      "type": "github-releases"
    }
  ],
  "last_update": "never"
}
EOF
    fi
}

# Fetch package index from GitHub releases
update_package_index() {
    init_repos
    
    echo -e "${BLUE}Updating package index...${NC}"
    
    # Read repositories
    local repos
    if command -v jq >/dev/null 2>&1; then
        repos=$(jq -r '.repositories[] | "\(.name)|\(.url)|\(.type)"' "$REPO_CONFIG")
    else
        # Fallback parsing
        repos=$(grep -A 2 '"name":' "$REPO_CONFIG" | paste - - - | sed 's/.*"name": *"\([^"]*\)".*/\1|'"$DEFAULT_REPO"'|github-releases/')
    fi
    
    local total_packages=0
    local index_file="$CACHE_DIR/package-index.json"
    
    # Initialize index
    echo '{"packages": [], "last_update": "'$(date -u +"%Y-%m-%dT%H:%M:%SZ")'"}' > "$index_file"
    
    while IFS='|' read -r repo_name repo_url repo_type; do
        if [[ -z "$repo_name" ]]; then continue; fi
        
        echo -e "  Fetching from ${CYAN}$repo_name${NC}..."
        
        case "$repo_type" in
            "github-releases")
                fetch_github_releases "$repo_name" "$repo_url" "$index_file"
                ;;
            *)
                echo -e "  ${YELLOW}Unknown repository type: $repo_type${NC}"
                ;;
        esac
    done <<< "$repos"
    
    # Update last update time
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    if command -v jq >/dev/null 2>&1; then
        jq --arg time "$timestamp" '.last_update = $time' "$REPO_CONFIG" > "$REPO_CONFIG.tmp" && mv "$REPO_CONFIG.tmp" "$REPO_CONFIG"
    fi
    
    total_packages=$(count_packages_in_index "$index_file")
    echo -e "${GREEN}✓ Package index updated: $total_packages packages available${NC}"
}

# Fetch packages from GitHub releases API
fetch_github_releases() {
    local repo_name="$1"
    local repo_url="$2"
    local index_file="$3"
    
    # Fetch releases (limit to first 30 for performance)
    local releases_json="$CACHE_DIR/${repo_name}-releases.json"
    
    if ! curl -s -L "$repo_url?per_page=30" > "$releases_json"; then
        echo -e "  ${RED}Failed to fetch releases from $repo_url${NC}"
        return 1
    fi
    
    # Parse releases and extract package information
    if command -v jq >/dev/null 2>&1; then
        parse_github_releases_jq "$repo_name" "$releases_json" "$index_file"
    else
        parse_github_releases_basic "$repo_name" "$releases_json" "$index_file"
    fi
}

# Parse GitHub releases with jq
parse_github_releases_jq() {
    local repo_name="$1"
    local releases_json="$2"
    local index_file="$3"
    
    # Extract package information from releases
    jq -r '.[] | select(.assets | length > 0) | 
          .assets[] | select(.name | test("\\.(zip|tar\\.gz)$")) |
          "\(.name)|\(.download_url)|\(.size)|\(.updated_at)"' "$releases_json" | \
    while IFS='|' read -r asset_name download_url size updated_at; do
        
        # Extract package name from asset name (remove version and extension)
        local package_name
        package_name=$(echo "$asset_name" | sed -E 's/[-_][0-9]+.*\.(zip|tar\.gz)$//' | tr '[:upper:]' '[:lower:]')
        
        if [[ -z "$package_name" ]]; then continue; fi
        
        # Add to package index
        local temp_file
        temp_file=$(mktemp)
        
        jq --arg name "$package_name" \
           --arg repo "$repo_name" \
           --arg url "$download_url" \
           --arg size "$size" \
           --arg updated "$updated_at" \
           --arg filename "$asset_name" \
           '.packages += [{
               "name": $name,
               "repository": $repo,
               "download_url": $url,
               "filename": $filename,
               "size": ($size | tonumber),
               "updated_at": $updated,
               "type": "archive"
           }]' "$index_file" > "$temp_file" && mv "$temp_file" "$index_file"
    done
}

# Basic parsing without jq (fallback)
parse_github_releases_basic() {
    local repo_name="$1"
    local releases_json="$2"
    local index_file="$3"
    
    # Simple grep-based parsing for .zip files
    grep -o '"browser_download_url": *"[^"]*\.zip"' "$releases_json" | \
    sed 's/"browser_download_url": *"//' | sed 's/"//' | \
    while read -r download_url; do
        local filename
        filename=$(basename "$download_url")
        local package_name
        package_name=$(echo "$filename" | sed -E 's/[-_][0-9]+.*\.zip$//' | tr '[:upper:]' '[:lower:]')
        
        echo "Found package: $package_name ($filename)"
    done
}

# Search remote packages
search_remote_packages() {
    local query="$1"
    
    if [[ -z "$query" ]]; then
        echo -e "${RED}Error: Search query required${NC}"
        exit 1
    fi
    
    local index_file="$CACHE_DIR/package-index.json"
    if [[ ! -f "$index_file" ]]; then
        echo -e "${YELLOW}Package index not found. Run: portx-repo update${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}Searching remote packages for '$query'...${NC}"
    echo
    
    local found=0
    
    if command -v jq >/dev/null 2>&1; then
        jq -r --arg query "$query" '.packages[] | select(.name | contains($query)) | 
               "\(.name)|\(.size)|\(.repository)|\(.updated_at)"' "$index_file" | \
        while IFS='|' read -r name size repo updated; do
            if [[ -n "$name" ]]; then
                echo -e "${BLUE}$name${NC} (${CYAN}$repo${NC})"
                echo "  Size: $(format_size "$size")"
                echo "  Updated: $(format_date "$updated")"
                echo
                ((found++))
            fi
        done
    else
        # Fallback search
        grep -i "$query" "$index_file" && echo "Found packages (use jq for detailed info)"
    fi
    
    if [[ $found -eq 0 ]]; then
        echo "No remote packages found matching '$query'"
        echo "Try: portx-repo list-remote"
    fi
}

# Install package from remote repository
install_remote_package() {
    local package_name="$1"
    
    if [[ -z "$package_name" ]]; then
        echo -e "${RED}Error: Package name required${NC}"
        exit 1
    fi
    
    local index_file="$CACHE_DIR/package-index.json"
    if [[ ! -f "$index_file" ]]; then
        echo -e "${YELLOW}Package index not found. Run: portx-repo update${NC}"
        exit 1
    fi
    
    # Find package in index
    local package_info
    if command -v jq >/dev/null 2>&1; then
        package_info=$(jq -r --arg name "$package_name" '.packages[] | select(.name == $name) | 
                       "\(.download_url)|\(.filename)|\(.size)"' "$index_file" | head -1)
    else
        echo -e "${RED}Error: jq required for package installation${NC}"
        exit 1
    fi
    
    if [[ -z "$package_info" ]]; then
        echo -e "${RED}Error: Package '$package_name' not found in remote repositories${NC}"
        echo "Try: portx-repo search $package_name"
        exit 1
    fi
    
    IFS='|' read -r download_url filename size <<< "$package_info"
    
    echo -e "${BLUE}Installing $package_name from remote repository...${NC}"
    echo "  Source: $filename"
    echo "  Size: $(format_size "$size")"
    echo
    
    # Download package
    local download_path="$CACHE_DIR/$filename"
    echo -e "${BLUE}Downloading...${NC}"
    
    if ! curl -L -o "$download_path" --progress-bar "$download_url"; then
        echo -e "${RED}Error: Failed to download package${NC}"
        exit 1
    fi
    
    # Extract package
    local extract_dir="$PKG_DIR/$package_name"
    mkdir -p "$extract_dir"
    
    echo -e "${BLUE}Extracting...${NC}"
    
    case "$filename" in
        *.zip)
            if command -v unzip >/dev/null 2>&1; then
                unzip -q "$download_path" -d "$extract_dir"
            else
                echo -e "${RED}Error: unzip not available${NC}"
                exit 1
            fi
            ;;
        *.tar.gz)
            tar -xzf "$download_path" -C "$extract_dir"
            ;;
        *)
            echo -e "${RED}Error: Unsupported archive format${NC}"
            exit 1
            ;;
    esac
    
    # Create basic package manifest
    create_package_manifest "$package_name" "$extract_dir" "$filename"
    
    # Register with local package manager
    if command -v portx-pkg >/dev/null 2>&1; then
        echo -e "${BLUE}Registering with package manager...${NC}"
        portx-pkg install "$package_name"
    fi
    
    echo -e "${GREEN}✓ Package '$package_name' installed successfully${NC}"
    
    # Clean up download
    rm -f "$download_path"
}

# Create basic package manifest
create_package_manifest() {
    local package_name="$1"
    local extract_dir="$2"
    local filename="$3"
    
    local manifest_file="$extract_dir/package-manual.md"
    
    if [[ ! -f "$manifest_file" ]]; then
        cat > "$manifest_file" << EOF
# $package_name

**Package Name**: $package_name  
**Source**: Remote repository  
**Archive**: $filename  
**Installed**: $(date)

## Description

This package was downloaded from the PORTX remote repository.

## Executables

EOF
        
        # List executables
        find "$extract_dir" -name "*.exe" -type f | while read -r exe; do
            local exe_name
            exe_name=$(basename "$exe" .exe)
            echo "- \`$exe_name\`" >> "$manifest_file"
        done
        
        cat >> "$manifest_file" << EOF

## Usage

Run executables directly from your PORTX environment:

\`\`\`bash
$package_name --help
\`\`\`

For more information, check the package documentation or run with \`--help\`.
EOF
    fi
}

# List all remote packages
list_remote_packages() {
    local index_file="$CACHE_DIR/package-index.json"
    if [[ ! -f "$index_file" ]]; then
        echo -e "${YELLOW}Package index not found. Run: portx-repo update${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}Remote packages:${NC}"
    echo
    
    if command -v jq >/dev/null 2>&1; then
        jq -r '.packages[] | "\(.name) - \(.repository) (\(.size | tostring) bytes)"' "$index_file" | sort | uniq
    else
        echo "Install jq for detailed package listing"
    fi
}

# Add repository
add_repository() {
    local repo_url="$1"
    
    if [[ -z "$repo_url" ]]; then
        echo -e "${RED}Error: Repository URL required${NC}"
        exit 1
    fi
    
    init_repos
    
    # Extract repository name from URL
    local repo_name
    repo_name=$(basename "$(dirname "$repo_url")")
    
    echo -e "${BLUE}Adding repository: $repo_name${NC}"
    echo "  URL: $repo_url"
    
    # Add to configuration
    if command -v jq >/dev/null 2>&1; then
        local temp_file
        temp_file=$(mktemp)
        
        jq --arg name "$repo_name" --arg url "$repo_url" \
           '.repositories += [{"name": $name, "url": $url, "type": "github-releases"}]' \
           "$REPO_CONFIG" > "$temp_file" && mv "$temp_file" "$REPO_CONFIG"
        
        echo -e "${GREEN}✓ Repository added successfully${NC}"
    else
        echo -e "${RED}Error: jq required for repository management${NC}"
        exit 1
    fi
}

# List repositories
list_repositories() {
    if [[ ! -f "$REPO_CONFIG" ]]; then
        echo "No repositories configured"
        return 0
    fi
    
    echo -e "${GREEN}Configured repositories:${NC}"
    echo
    
    if command -v jq >/dev/null 2>&1; then
        jq -r '.repositories[] | "  \(.name) - \(.url)"' "$REPO_CONFIG"
    else
        grep -A 1 '"name":' "$REPO_CONFIG" | grep -v '^--$'
    fi
}

# Utility functions
format_size() {
    local size="$1"
    if [[ "$size" -gt 1048576 ]]; then
        echo "$((size / 1048576))MB"
    elif [[ "$size" -gt 1024 ]]; then
        echo "$((size / 1024))KB"
    else
        echo "${size}B"
    fi
}

format_date() {
    local iso_date="$1"
    # Simple date formatting (could be enhanced)
    echo "$iso_date" | cut -d'T' -f1
}

count_packages_in_index() {
    local index_file="$1"
    if command -v jq >/dev/null 2>&1; then
        jq '.packages | length' "$index_file"
    else
        grep -c '"name":' "$index_file" || echo "0"
    fi
}

clear_cache() {
    echo -e "${BLUE}Clearing download cache...${NC}"
    rm -rf "$CACHE_DIR"
    mkdir -p "$CACHE_DIR"
    echo -e "${GREEN}✓ Cache cleared${NC}"
}

# Main command dispatcher
main() {
    local command="${1:-}"
    
    case "$command" in
        "update"|"refresh")
            update_package_index
            ;;
        "search"|"s")
            search_remote_packages "${2:-}"
            ;;
        "install"|"i")
            install_remote_package "${2:-}"
            ;;
        "info"|"show")
            # TODO: Show detailed remote package info
            echo "Remote package info not implemented yet"
            ;;
        "list-remote"|"remote")
            list_remote_packages
            ;;
        "add-repo"|"add")
            add_repository "${2:-}"
            ;;
        "list-repos"|"repos")
            list_repositories
            ;;
        "cache-clear"|"clear")
            clear_cache
            ;;
        "help"|"-h"|"--help"|"")
            show_usage
            ;;
        *)
            echo -e "${RED}Unknown command: $command${NC}"
            echo
            show_usage
            exit 1
            ;;
    esac
}

# Run main function
main "$@"