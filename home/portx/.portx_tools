# Utility functions for tools management
show_tools_info() {
    echo "Tools Cache Info:"
    echo "  Total directories: 84"
    echo "  Last scan: $(date -d "$TOOLS_LAST_SCAN" 2>/dev/null || echo 'Unknown')"
    echo "  Scan depth: 4 levels"
    echo "  Min executables: 1 per directory"
    echo "  Cache file: .portx_tools"
}

regenerate_tools_cache() {
    echo "Removing cache file..."
    rm -f "/home/portx/.portx_tools"
    echo "Regenerating tools cache with deep scan..."
    load_portx_tools
    show_tools_info
}

list_tool_directories() {
    echo "Current tool directories in PATH:"
    echo "$PATH" | tr ':' '\n' | grep -E '/(bin|exe|cmd|tools?)(/|$)' | nl
}
