# PORTX Git Ignore
# Generated cache files
.portx_cache
.portx_cache.log

# Package binaries (keep only directory structure)
packages/*/
!packages/*/package.json

# SSH certificates (keep config, ignore sensitive files)
.ssh/*.pem
.ssh/*.key
.ssh/id_*
.ssh/known_hosts*

# Git configuration files (user-specific)
.gitconfig
.gitignore_global

# Claude files
.claude/
claude.md
CLAUDE.md

# Bash history
.bash_history

# Temporary files
*.tmp
*.temp
*.bak
*.backup