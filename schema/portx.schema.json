{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://portx.io/schema/portx.json",
  "title": "PORTX Package Schema",
  "description": "Schema for PORTX portx.json files",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "importType"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-])*[a-z0-9]?$",
      "description": "Package name (lowercase, alphanumeric with hyphens)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (major.minor.patch)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Brief package description (minimum 10 characters)"
    },
    "importType": {
      "type": "string",
      "enum": [
        "wrap",
        "path",
        "none",
        "wrapAndPath"
      ],
      "description": "Import strategy: wrap (create wrappers with intelligent PATH detection), path (add paths array directories to PATH), none (documentation only, no imports), wrapAndPath (create wrappers AND add to PATH for maximum compatibility)"
    },
    "bin": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9-]+$": {
          "type": "object",
          "required": [
            "path",
            "description",
            "tags"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[^/].*\\.(exe|cmd|bat|sh)$",
              "description": "Executable path from package root (e.g., bin/tool.exe or tool.exe)"
            },
            "description": {
              "type": "string",
              "minLength": 10,
              "description": "Tool description (minimum 10 characters)"
            },
            "usage": {
              "type": "string",
              "description": "Usage examples and command patterns"
            },
            "dependencies": {
              "type": "string",
              "enum": [
                "windows",
                "linux",
                "cross-platform",
                "native"
              ],
              "default": "windows",
              "description": "Platform dependencies"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
