  "additionalProperties": false,
  "anyOf": [
    {
      "if": {
        "properties": {
          "importType": {
            "const": "wrap"
          }
        }
      },
      "then": {
        "required": [
          "bin"
        ],
        "properties": {
          "bin": {
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "importType": {
            "const": "wrapAndPath"
          }
        }
      },
      "then": {
        "required": [
          "bin"
        ],
        "properties": {
          "bin": {
            "minProperties": 1
          }
        }
      }
    },
    true
  ]
