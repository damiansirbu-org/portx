#!/bin/bash
# PORTX Tools Interface
# By Damian Sirbu
# A simplified, reliable interface for PORTX tool discovery

# Determine PORTX_ROOT - prioritize production installation
if [[ -f "C:/App/PORTX/doc-portx/tools.md" ]]; then
    PORTX_ROOT="C:/App/PORTX"
elif [[ -n "$PORTX_ROOT" ]]; then
    PORTX_ROOT="$PORTX_ROOT"
elif [[ -n "${BASH_SOURCE[0]}" ]]; then
    PORTX_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
else
    echo "Error: Cannot locate PORTX installation"
    exit 1
fi

TOOLS_FILE="$PORTX_ROOT/doc-portx/tools.md"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
RED='\033[0;31m'
NC='\033[0m'

show_header() {
    echo -e "${BLUE}================================${NC}"
    echo -e "${BLUE}    PORTX - 501 Professional Tools${NC}"
    echo -e "${BLUE}================================${NC}"
    echo
}

show_usage() {
    show_header
    echo -e "${GREEN}Usage:${NC}"
    echo "  portx-tools                   Show tool count"
    echo "  portx-tools find              Launch interactive tool finder (TUI)"
    echo "  portx-tools search <term>     Search for tools"
    echo "  portx-tools list [category]   List tools by category"
    echo "  portx-tools stats             Show statistics"
    echo "  portx-tools info <tool>       Show tool information"
    echo
    echo -e "${GREEN}Examples:${NC}"
    echo "  portx-tools                   # Output: 538"
    echo "  portx-tools find              # Opens fzf-based tool browser"
    echo "  portx-tools search git"
    echo "  portx-tools list security"
    echo "  portx-tools info kubectl"
}

show_count() {
    # Count tools from researched database
    local tools_researched="$PORTX_ROOT/doc-portx/tools-researched.txt"
    if [[ -f "$tools_researched" ]]; then
        grep -v "^#" "$tools_researched" | grep -v "^$" | wc -l
    else
        # Fallback to tools.md
        grep "^|" "$TOOLS_FILE" | grep -v "^| Name" | grep -v "^|---" | wc -l
    fi
}

launch_finder() {
    local finder_script="$PORTX_ROOT/bin-ext/portx-find-tools"
    if [[ -f "$finder_script" ]]; then
        "$finder_script"
    else
        echo -e "${RED}Error: Interactive tool finder not found at $finder_script${NC}"
        exit 1
    fi
}

search_tools() {
    local search_term="$1"
    
    if [[ ! -f "$TOOLS_FILE" ]]; then
        echo -e "${RED}Error: Tools catalog not found${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}Searching for: ${YELLOW}$search_term${NC}"
    echo "----------------------------------------"
    
    local results=$(grep "^|" "$TOOLS_FILE" | grep -v "^| Name" | grep -v "^|---" | grep -i "$search_term")
    
    if [[ -z "$results" ]]; then
        echo -e "${RED}No tools found matching '$search_term'${NC}"
        return 1
    fi
    
    local count=$(echo "$results" | wc -l)
    echo -e "${GREEN}Found $count tools:${NC}"
    echo
    
    local i=1
    while IFS= read -r line; do
        if [[ -n "$line" ]]; then
            local name=$(echo "$line" | cut -d'|' -f2 | xargs)
            local category=$(echo "$line" | cut -d'|' -f4 | xargs)
            local description=$(echo "$line" | cut -d'|' -f5 | xargs)
            
            printf "${BLUE}%2d.${NC} ${GREEN}%-20s${NC} [${CYAN}%s${NC}]\n" "$i" "$name" "$category"
            printf "     %s\n" "$description"
            echo
            ((i++))
        fi
    done <<< "$results"
}

list_categories() {
    local filter="$1"
    
    if [[ ! -f "$TOOLS_FILE" ]]; then
        echo -e "${RED}Error: Tools catalog not found${NC}"
        exit 1
    fi
    
    if [[ -n "$filter" ]]; then
        echo -e "${GREEN}Tools in category: ${YELLOW}$filter${NC}"
        echo "----------------------------------------"
        
        local results=$(grep "^|" "$TOOLS_FILE" | grep -v "^| Name" | grep -v "^|---" | grep -i "$filter")
        
        if [[ -z "$results" ]]; then
            echo -e "${RED}No tools found in category '$filter'${NC}"
            return 1
        fi
        
        while IFS= read -r line; do
            if [[ -n "$line" ]]; then
                local name=$(echo "$line" | cut -d'|' -f2 | xargs)
                local executable=$(echo "$line" | cut -d'|' -f3 | xargs)
                local description=$(echo "$line" | cut -d'|' -f5 | xargs)
                
                printf "${GREEN}%-20s${NC} %s\n" "$name" "$description"
                printf "  ${BLUE}->${NC} %s\n" "$executable"
                echo
            fi
        done <<< "$results"
    else
        echo -e "${GREEN}Available Categories:${NC}"
        echo "----------------------------------------"
        
        # Extract unique categories
        grep "^|" "$TOOLS_FILE" | grep -v "^| Name" | grep -v "^|---" | \
        cut -d'|' -f4 | xargs -I {} echo {} | sort | uniq -c | sort -nr | \
        while read count category; do
            if [[ -n "$category" && "$category" != "Category" ]]; then
                printf "${CYAN}%-20s${NC} (%d tools)\n" "$category" "$count"
            fi
        done
    fi
}

show_stats() {
    if [[ ! -f "$TOOLS_FILE" ]]; then
        echo -e "${RED}Error: Tools catalog not found${NC}"
        exit 1
    fi
    
    show_header
    
    local total=$(grep "^|" "$TOOLS_FILE" | grep -v "^| Name" | grep -v "^|---" | wc -l)
    echo -e "${GREEN}Total Tools: ${YELLOW}$total${NC}"
    echo
    echo -e "${GREEN}Installation: ${YELLOW}$PORTX_ROOT${NC}"
    echo -e "${GREEN}Catalog: ${YELLOW}$TOOLS_FILE${NC}"
    echo
    
    echo -e "${GREEN}Top Categories:${NC}"
    grep "^|" "$TOOLS_FILE" | grep -v "^| Name" | grep -v "^|---" | \
    cut -d'|' -f4 | xargs -I {} echo {} | sort | uniq -c | sort -nr | head -10 | \
    while read count category; do
        if [[ -n "$category" && "$category" != "Category" ]]; then
            printf "  ${CYAN}%-20s${NC} %d tools\n" "$category" "$count"
        fi
    done
}

show_tool_info() {
    local tool_name="$1"
    
    if [[ ! -f "$TOOLS_FILE" ]]; then
        echo -e "${RED}Error: Tools catalog not found${NC}"
        exit 1
    fi
    
    local result=$(grep "^|" "$TOOLS_FILE" | grep -v "^| Name" | grep -v "^|---" | grep -i "^| $tool_name ")
    
    if [[ -z "$result" ]]; then
        echo -e "${RED}Tool '$tool_name' not found${NC}"
        echo -e "${YELLOW}Try: portx-tools search $tool_name${NC}"
        return 1
    fi
    
    local name=$(echo "$result" | cut -d'|' -f2 | xargs)
    local executable=$(echo "$result" | cut -d'|' -f3 | xargs)
    local category=$(echo "$result" | cut -d'|' -f4 | xargs)
    local description=$(echo "$result" | cut -d'|' -f5 | xargs)
    
    echo -e "${GREEN}Tool Information:${NC}"
    echo "----------------------------------------"
    echo -e "${CYAN}Name:${NC} $name"
    echo -e "${CYAN}Category:${NC} $category"
    echo -e "${CYAN}Executable:${NC} $executable"
    echo -e "${CYAN}Description:${NC} $description"
    echo
    
    local full_path="$PORTX_ROOT/$executable"
    if [[ -f "$full_path" ]]; then
        echo -e "${GREEN}✓ Tool exists at: $full_path${NC}"
    else
        echo -e "${RED}✗ Tool not found at: $full_path${NC}"
    fi
    
    if command -v "$name" >/dev/null 2>&1; then
        echo -e "${GREEN}✓ Tool is in PATH${NC}"
    else
        echo -e "${YELLOW}! Tool not in current PATH${NC}"
    fi
}

# Main function
case "${1:-}" in
    "")
        show_count
        ;;
    "find")
        launch_finder
        ;;
    "search")
        if [[ -z "$2" ]]; then
            echo -e "${RED}Error: Search term required${NC}"
            echo "Usage: portx-tools search <term>"
            exit 1
        fi
        search_tools "$2"
        ;;
    "list")
        list_categories "$2"
        ;;
    "stats")
        show_stats
        ;;
    "info")
        if [[ -z "$2" ]]; then
            echo -e "${RED}Error: Tool name required${NC}"
            echo "Usage: portx-tools info <tool>"
            exit 1
        fi
        show_tool_info "$2"
        ;;
    "help"|"-h"|"--help")
        show_usage
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        show_usage
        exit 1
        ;;
esac