#!/bin/bash
# PORTX Tool Finder - Using researched data
# Simple fzf interface with the new categorized tools

PORTX_ROOT="${PORTX_ROOT:-C:/App/PORTX}"
TOOLS_FILE="$PORTX_ROOT/doc-portx/tools-researched.txt"

if [[ ! -f "$TOOLS_FILE" ]]; then
    echo "❌ Tools file not found: $TOOLS_FILE"
    echo "Run scan-executables.sh and research-categorize.sh first"
    exit 1
fi

echo "🔍 PORTX Tools ($(grep -v '^#' "$TOOLS_FILE" | grep -v '^$' | wc -l) tools) - Type to search..."

# Simple fzf with the researched data
grep -v "^#" "$TOOLS_FILE" | grep -v "^$" | \
fzf \
    --prompt="🔍 Search PORTX: " \
    --header="Type to search · Enter=show details · Esc=quit" \
    --delimiter="|" \
    --sync \
    --no-select-1 \
    --preview='
        # Parse the selected line
        line={}
        tool=$(echo "$line" | cut -d"|" -f1)
        category=$(echo "$line" | cut -d"|" -f2) 
        path=$(echo "$line" | cut -d"|" -f3)
        desc=$(echo "$line" | cut -d"|" -f4)
        usage=$(echo "$line" | cut -d"|" -f5)
        
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "Tool: $tool"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "Category: $category"
        echo "Path: $path"
        echo ""
        echo "Description:"
        echo -e "$desc" | fold -w 80 -s
        echo ""
        echo "Usage Examples:"
        echo -e "$usage" | fold -w 80 -s
        echo ""
        
        # Check if tool exists and is in PATH
        full_path="'"$PORTX_ROOT"'/$path"
        echo ""
        echo "Status:"
        if command -v "$tool" >/dev/null 2>&1; then
            echo "Ready to use"
        elif [[ -f "$full_path" ]]; then
            echo "Not in PATH"
        else
            echo "Tool missing"
        fi
    ' \
    --preview-window=right:60% \
    --layout=reverse \
    --border \
    --bind='change:first' \
    --bind='enter:execute(
        line={}
        tool=$(echo "$line" | cut -d"|" -f1)
        category=$(echo "$line" | cut -d"|" -f2)
        path=$(echo "$line" | cut -d"|" -f3)
        desc=$(echo "$line" | cut -d"|" -f4)
        usage=$(echo "$line" | cut -d"|" -f5)
        
        clear
        echo "═══════════════════════════════════════════════════════════════"
        echo "🔧 $tool"
        echo "═══════════════════════════════════════════════════════════════"
        echo ""
        echo "📂 Category: $category"
        echo "📁 Path: $path"
        echo ""
        echo "📝 Description:"
        echo "$desc"
        echo ""
        echo "💡 Usage Examples:"
        echo "$usage"
        echo ""
        echo "🔗 Full Path: '"$PORTX_ROOT"'/$path"
        echo ""
        echo "Actions:"
        echo "  h - Show help for this tool"
        echo "  c - Copy tool name to clipboard"
        echo "  Enter - Back to search"
        echo ""
        read -n1 -p "Choose action [h/c/Enter]: " action
        case "$action" in
            h|H)
                echo ""
                echo "Getting help for $tool..."
                if command -v "$tool" >/dev/null 2>&1; then
                    "$tool" --help 2>/dev/null | head -20 || echo "No help available"
                else
                    echo "Tool not in PATH. Try: '"$PORTX_ROOT"'/$path --help"
                fi
                echo ""
                read -p "Press Enter to continue..."
                ;;
            c|C)
                if command -v clip.exe >/dev/null 2>&1; then
                    echo "$tool" | clip.exe
                    echo ""
                    echo "✅ Copied \"$tool\" to clipboard"
                else
                    echo ""
                    echo "📋 Copy this: $tool"
                fi
                read -p "Press Enter to continue..."
                ;;
        esac
    )'