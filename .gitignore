# PORTX Multi-Platform Tool Manager .gitignore

# Exclude Claude configuration
.claude/

# Exclude packages directory except specific included items
packages/
!packages/*/portx.json
!packages/node/

# Include packages directory structure but exclude binaries and large files
packages/*/
!packages/*/portx.json
!packages/node/

# Node package specific excludes
packages/node/node_modules/
packages/node/*.exe
packages/node/*.cmd
packages/node/*.dll
packages/node/*.pdb
packages/node/*.lib
packages/node/*.exp

# Keep only the essential node package files
!packages/node/portx.json
!packages/node/claude
!packages/node/node
!packages/node/npm
!packages/node/npx
!packages/node/corepack

# Build artifacts
build/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp
*.temp

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# General build artifacts
vendor/
*.exe
*.dll
*.so
*.dylib

# Test files
*_test.go
test/
tests/

# Documentation generation
doc/generated/

# Backup files
*.bak
*.backup
*~

# Lock files
*.lock