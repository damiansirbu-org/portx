# PORTX Production Git Ignore
# ===========================

# Package binaries (keep only directory structure and metadata)
packages/**
!packages/
!packages/*/
!packages/*/portx.json
!packages/*/README.md

# Exception: analyze-code package should be fully version controlled
!packages/analyze-code/
!packages/analyze-code/**

# SSH certificates and keys (keep config, ignore sensitive files)
.ssh/*.pem
.ssh/*.key  
.ssh/id_*
.ssh/known_hosts*
.ssh/agent.env
.ssh/.portx_keys_added
.ssh/cached_user

# Generated cache files (committed to repo for performance)
# .portx_cache - now committed for faster startup
# .portx_tools_cache - committed for documentation
# .portx_exes_cache - committed for performance
# .portx_cache.log - import logs, not committed
.portx_cache.log

# Log files (generated by portx operations)
*.log
portx-*.log

# Git configuration files (user-specific)
.gitconfig
.gitignore_global

# Bash history and user files
.bash_history

# Temporary files
*.tmp
*.temp
*.bak
*.backup
packages.7z.tmp

# Config directories that may contain sensitive data
.config/

# Claude files (if any)
.claude/
claude.md
CLAUDE.md