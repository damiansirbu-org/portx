# PORTX Package Binaries
# Exclude all package contents except directories and portx.json files

# Exclude everything in packages/* except what we explicitly allow
packages/**/*

# Allow first-level directories in packages/
!packages/*/

# Allow portx.json files
!packages/**/portx.json

# But exclude subdirectories and their contents (except portx.json)
packages/*/*/
!packages/*/portx.json

# PORTX Generated Wrappers
# Exclude all generated wrapper scripts
wrappers/*